# EcoLogic local-development defaults. Copy this file to .env; never commit .env.
ECOLOGIC_ENV=development
ECOLOGIC_PROVIDER=demo
ECOLOGIC_SECRET_KEY=
ECOLOGIC_SECURE_COOKIES=false
ECOLOGIC_TRUSTED_HOSTS=

# Leave blank to use instance/ecologic.sqlite3.
ECOLOGIC_DATABASE=
ECOLOGIC_HISTORY_RETENTION_DAYS=30
ECOLOGIC_HISTORY_LIMIT=10

# Request and upload limits (bytes unless noted).
ECOLOGIC_MAX_REQUEST_BYTES=3145728
ECOLOGIC_MAX_TEXT_LENGTH=4000
ECOLOGIC_MAX_IMAGE_BYTES=2097152

# Single-process development abuse brakes; not production quotas.
ECOLOGIC_ANALYSIS_RATE_LIMIT=10
ECOLOGIC_ANALYSIS_RATE_WINDOW=60
ECOLOGIC_COACH_RATE_LIMIT=15
ECOLOGIC_COACH_RATE_WINDOW=3600
ECOLOGIC_CHAT_RATE_LIMIT=30
ECOLOGIC_CHAT_RATE_WINDOW=60
ECOLOGIC_RATE_LIMIT_MAX_KEYS=2048

# Local server binding.
ECOLOGIC_HOST=127.0.0.1
ECOLOGIC_PORT=5000

# Optional, experimental live provider. Demo mode ignores these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=45

# Production additionally requires:
# ECOLOGIC_ENV=production
# ECOLOGIC_SECURE_COOKIES=true
# ECOLOGIC_SECRET_KEY with at least 32 UTF-8 bytes; generate a random,
# high-entropy value (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
# ECOLOGIC_TRUSTED_HOSTS=your.example.com
